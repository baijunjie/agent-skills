{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/wrapup-check.sh\"",
            "timeout": 10,
            "statusMessage": "核对收尾同步"
          }
        ]
      }
    ]
  }
}
